static int language_normalized(int language)
{
    return language >= LANG_EN && language < LANG_COUNT ? language : LANG_EN;
}

static const char *language_label(int language)
{
    switch (language_normalized(language)) {
    case LANG_ES:
        return "Espa" "\xC3\xB1" "ol";
    case LANG_EN:
    default:
        return "English";
    }
}

static const char *tr(StringId id)
{
    if ((unsigned)id >= (unsigned)TR_LANGUAGE_COUNT) {
        return "";
    }

    const char *text = NULL;
    if (language_normalized(g_cfg.language) == LANG_ES) {
        text = STRINGS_ES[id];
    }
    if (!text) {
        text = STRINGS_EN[id];
    }
    return text ? text : "";
}
